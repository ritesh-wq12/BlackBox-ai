# BlackBox AI explanation layer (optional).
# BlackBox reads these from the process environment — there is no .env loader,
# so export them in your shell (or use your secret manager) before `blackbox start`.
# Without them, explanations are produced deterministically by the local fallback.

# Provider: "anthropic" | "openai" | "openai-compatible"
# For openai-compatible, also set BLACKBOX_AI_BASE_URL.
BLACKBOX_AI_PROVIDER=openai

# Provider API key — never logged and never returned by the server.
BLACKBOX_AI_API_KEY=your-api-key-here

# Optional model override (defaults: claude-haiku-4-5 / gpt-4o-mini)
BLACKBOX_AI_MODEL=

# Optional OpenAI-format base URL (required when provider is "openai-compatible").
# Examples:
#   Groq:    https://api.groq.com/openai/v1/chat/completions
#   OpenRouter https://api.openrouter.ai/v1/chat/completions
#   Ollama:  http://localhost:11434/v1/chat/completions
BLACKBOX_AI_BASE_URL=

# Optional request timeout in milliseconds (default 10000)
BLACKBOX_AI_TIMEOUT_MS=10000
